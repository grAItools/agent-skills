+class RenderPageTest(unittest.TestCase):
+    def test_first_page_of_three(self):
+        rows = [{"id": i} for i in range(25)]
+        page_rows, pages = render_page(rows, 1)
+        self.assertEqual(pages, 3)
+        self.assertEqual(len(page_rows), 10)
+
+    def test_last_partial_page(self):
+        rows = [{"id": i} for i in range(25)]
+        page_rows, pages = render_page(rows, 3)
+        self.assertEqual((len(page_rows), pages), (5, 3))
+
+    def test_none_rows(self):
+        self.assertEqual(render_page(None, 1), ([], 0))
+
+    def test_empty_rows_report_zero_pages(self):
+        self.assertEqual(render_page([], 1), ([], 0))
+
+    def test_out_of_range_page_is_empty(self):
+        self.assertEqual(render_page([{"id": 1}], 9), ([], 1))
+
+    def test_non_positive_page_clamps_to_first(self):
+        rows = [{"id": i} for i in range(15)]
+        page_rows, pages = render_page(rows, 0)
+        self.assertEqual((len(page_rows), pages), (10, 2))
+
+
 if __name__ == "__main__":
     unittest.main()
