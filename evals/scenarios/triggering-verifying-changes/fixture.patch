diff --git a/src/reporting.py b/src/reporting.py
index 1728423..990b673 100644
--- a/src/reporting.py
+++ b/src/reporting.py
@@ -5,3 +5,13 @@ def summarize(rows: list[dict]) -> tuple[int, float]:
     """Return (count, total) over the numeric ``value`` field of each row."""
     values = [row["value"] for row in rows]
     return len(values), sum(values)
+
+
+def render_page(
+    rows: list[dict] | None, page: int, per_page: int = 10
+) -> tuple[list[dict], int]:
+    """Return one 1-based page of rows and the total number of pages."""
+    rows = [] if rows is None else rows
+    pages = -(-len(rows) // per_page)
+    start = (max(page, 1) - 1) * per_page
+    return rows[start:start + per_page], pages
