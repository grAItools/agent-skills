// One case per line: a realistic prompt, the skills that must fire, and the
// skills that must stay silent. A skill named in neither list is unjudged, so a
// case can be added for one skill without re-labelling the others.
// Blank lines and `//` lines are ignored. See CONTRIBUTING.md, "The trigger eval".

// --- discovering-requirements: a solution-shaped ask, or an unclear one ------
{"prompt": "The sales team wants a dashboard. Can you add one to the admin area?", "fires": ["discovering-requirements"], "silent": ["designing-before-coding", "implementing-strategically"]}
{"prompt": "A customer filed a bug that just says 'export is broken'. That's the whole report. Where do I start?", "fires": ["discovering-requirements"], "silent": ["implementing-strategically", "verifying-changes"]}
{"prompt": "Someone in the standup asked for 'a way to bulk edit'. Nobody could say which records or who needs it.", "fires": ["discovering-requirements"], "silent": ["designing-before-coding"]}

// --- designing-before-coding: the need is settled, the structure is not ------
{"prompt": "We've agreed we're doing multi-tenant billing. Before I write anything, how should the modules and the data model be laid out?", "fires": ["designing-before-coding"], "silent": ["discovering-requirements", "implementing-strategically"]}
{"prompt": "Adding webhook retries doesn't fit our current queue wrapper — I think it needs a real abstraction rather than another flag. What structure would you propose?", "fires": ["designing-before-coding"], "silent": ["refactoring-continuously"]}

// --- implementing-strategically: the plan exists, the code does not ----------
{"prompt": "The spec is signed off and written up in docs/rfc-014.md. Start building it.", "fires": ["implementing-strategically"], "silent": ["discovering-requirements"]}
{"prompt": "Implement the CSV importer described in docs/design.md — the interfaces are already decided.", "fires": ["implementing-strategically"], "silent": ["discovering-requirements", "designing-before-coding"]}
{"prompt": "This fits the existing structure fine: add the `locale` field and wire it through the two call sites.", "fires": ["implementing-strategically"], "silent": ["designing-before-coding"]}
{"prompt": "We have to ship this Friday. Just make the retry work, I don't care how pretty it is.", "fires": ["implementing-strategically"], "silent": ["refactoring-continuously", "designing-before-coding"]}

// --- refactoring-continuously: the code is fighting the change ---------------
{"prompt": "This is supposed to be a one-line price change and it needs edits in eleven files.", "fires": ["refactoring-continuously"], "silent": ["designing-before-coding"]}
{"prompt": "The checkout module breaks every single time we touch it. At this point nobody on the team wants to go near it.", "fires": ["refactoring-continuously"], "silent": ["implementing-strategically", "verifying-changes"]}
{"prompt": "We've called it a 'workspace' in every conversation for a year, but the code still says 'account' everywhere. It's getting confusing to talk about.", "fires": ["refactoring-continuously"], "silent": ["discovering-requirements"]}

// --- verifying-changes: it is believed done ---------------------------------
{"prompt": "Here's my pull request. Can you review it before I merge?", "fires": ["verifying-changes"], "silent": ["implementing-strategically"]}
{"prompt": "All the tests pass. Are we good to ship this?", "fires": ["verifying-changes"], "silent": ["delivering-for-feedback"]}
{"prompt": "Read this design document and tell me whether it holds up.", "fires": ["verifying-changes"], "silent": ["designing-before-coding"]}
{"prompt": "I think this is done. Check the implementation against what the ticket actually asked for.", "fires": ["verifying-changes"], "silent": ["implementing-strategically"]}

// --- delivering-for-feedback: it works, when does it go out ------------------
{"prompt": "Marketing wants to hold the launch until the full reporting suite is in. We have a working version right now.", "fires": ["delivering-for-feedback"], "silent": ["verifying-changes"]}
{"prompt": "We've been building for two months and haven't put it in front of a single customer yet.", "fires": ["delivering-for-feedback"], "silent": ["implementing-strategically"]}
{"prompt": "How small a slice of this could we get in front of real users next week?", "fires": ["delivering-for-feedback"], "silent": ["designing-before-coding"]}

// --- nothing should fire: over-firing costs context in every session ---------
{"prompt": "What's the difference between a mutex and a semaphore?", "fires": [], "silent": ["discovering-requirements", "designing-before-coding", "implementing-strategically", "verifying-changes", "refactoring-continuously", "delivering-for-feedback"]}
{"prompt": "Rename the local variable `x` to `count` in this function.", "fires": [], "silent": ["refactoring-continuously", "implementing-strategically", "designing-before-coding"]}
{"prompt": "Our CI runner keeps running out of disk space. Can you clear the old build caches?", "fires": [], "silent": ["discovering-requirements", "designing-before-coding", "implementing-strategically", "verifying-changes", "refactoring-continuously", "delivering-for-feedback"]}
{"prompt": "We ship Thursday. Can you tidy up the formatting and modernize the old callback style while you're in there?", "fires": [], "silent": ["refactoring-continuously"]}
